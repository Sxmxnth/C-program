//sum of all digits and occurens of a digit in a number
#include <stdio.h>

int main() {
    int num, digit, sum = 0;
    int count[10] = {0};  

    printf("Enter a number: ");
    scanf("%d", &num);

    int temp = num;

    while (temp != 0) {
        digit = temp % 10;    
        sum += digit;         
        count[digit]++;       
        temp /= 10;          
    }

    printf("\nSum of digits = %d\n", sum);

    printf("Digit occurrences:\n");
    for (int i = 0; i < 10; i++) {
        if (count[i] > 0)
            printf("Digit %d occurs %d times\n", i, count[i]);
    }

    return 0;
}
